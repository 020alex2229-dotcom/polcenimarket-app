{
  "expo": {
    "name": "ПолЦены Маркет",
    "slug": "polcenimarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polcenimarket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.polcenimarket.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Приложению нужен доступ к геолокации, чтобы показать магазины ПолЦены Маркет рядом с вами.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Приложению нужен доступ к геолокации, чтобы показать магазины ПолЦены Маркет рядом с вами."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "ru.polcenimarket.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6EE"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Приложению нужен доступ к геолокации, чтобы показать магазины ПолЦены Маркет рядом с вами."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2363ecc0-40ee-49af-be88-8963f0935584"
      }
    },
    "owner": "polcenimarket"
  }
}
